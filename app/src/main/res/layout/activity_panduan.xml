<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F8">

    <!-- HEADER -->
    <TextView
        android:id="@+id/txtJudul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="100dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="Panduan"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubjudul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/montserrat_medium"
        android:text="Pelajari cara membuat surat dengan benar"
        android:textColor="@color/black"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtJudul" />

    <ImageView
        android:id="@+id/logoSekolah"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_smkn_2_singosari" />

    <!-- SCROLLVIEW KONTEN -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/navbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSubjudul">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- ACCORDION: SURAT DISPENSASI -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Tombol Header Dispensasi -->
                    <LinearLayout
                        android:id="@+id/btn_dispensasi"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/gradient_card_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_white_bg"
                            android:padding="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_suratdispen" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Surat Dispensasi"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/arrow_dispensasi"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/arrow_down_float" />
                    </LinearLayout>

                    <!-- Konten Dispensasi -->
                    <LinearLayout
                        android:id="@+id/content_dispensasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- Step 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/gradient_card_background"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:fontFamily="@font/montserrat_bold"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="Hubungi Guru atau Pembina Ekskul"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_medium"
                                    android:text="Hubungi guru mata pelajaran atau pembina ekstrakurikuler yang berkaitan dengan kegiatan tersebut."
                                    android:textColor="#555555"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/gradient_card_background"
                                android:gravity="center"
                                android:text="2"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:fontFamily="@font/montserrat_bold"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="Sampaikan Keperluannya"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_medium"
                                    android:text="Jelaskan alasan dispensasi, tanggal kegiatan, durasi izin, serta daftar siswa yang mengikuti."
                                    android:textColor="#555555"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/gradient_card_background"
                                android:gravity="center"
                                android:text="3"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:fontFamily="@font/montserrat_bold"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="Tunggu Surat yang Dibuat"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_medium"
                                    android:text="Guru atau pembina akan membuatkan surat dispensasi melalui aplikasi."
                                    android:textColor="#555555"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/gradient_card_background"
                                android:gravity="center"
                                android:text="4"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:fontFamily="@font/montserrat_bold"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:text="Terima Surat"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat_medium"
                                    android:text="Setelah selesai, siswa dapat melihat surat lalu menunjukkannya kepada guru terkait."
                                    android:textColor="#555555"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ACCORDION: SURAT IZIN MASUK -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_izinmasuk"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/gradient_card_background_2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_white_bg"
                            android:padding="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_izinmasuk" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Surat Izin Masuk"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/arrow_izinmasuk"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/arrow_down_float" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_izinmasuk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- Step 1 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_2" android:gravity="center" android:text="1" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Isi Form Surat" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Masukkan nama, kelas, jurusan, serta keterangan atau alasan mengapa masuk sekolah." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 2 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_2" android:gravity="center" android:text="2" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Periksa Kembali Data" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Pastikan semua data yang diisi sudah benar dan sesuai." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 3 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_2" android:gravity="center" android:text="3" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Tanda Tangan" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Minta tanda tangan petugas tata tertib." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 4 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_2" android:gravity="center" android:text="4" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Serahkan Surat" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Berikan surat kepada guru piket atau guru mapel yang bersangkutan dan tata tertib sebelum masuk kelas." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ACCORDION: SURAT IZIN KELUAR -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_izinkeluar"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/gradient_card_background_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_white_bg"
                            android:padding="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_izinkeluar" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Surat Izin Keluar"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/arrow_izinkeluar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/arrow_down_float" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_izinkeluar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- Step 1 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_3" android:gravity="center" android:text="1" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Isi Form Surat" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Masukkan nama, kelas, jurusan, serta keterangan atau alasan mengapa harus keluar sekolah." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 2 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_3" android:gravity="center" android:text="2" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Periksa Kembali Data" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Pastikan alasan yang ditulis jelas dan dapat dipertanggungjawabkan." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 3 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_3" android:gravity="center" android:text="3" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Tanda Tangan" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Minta tanda tangan petugas tata tertib." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 4 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/gradient_card_background_3" android:gravity="center" android:text="4" android:textColor="@color/white" android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Serahkan Surat" android:textColor="@color/black" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium" android:text="Berikan surat kepada guru piket atau guru mapel yang bersangkutan sebelum keluar sekolah." android:textColor="#555555" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- NAVBAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navbar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/nav_beranda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/navhome_grey" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Beranda" android:textColor="#9E9E9E" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_panduan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/navbook_blue" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Panduan" android:textColor="#5BB8F5" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_riwayat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/navclock_grey" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Riwayat" android:textColor="#9E9E9E" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_profil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/navuser_grey" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profil" android:textColor="#9E9E9E" android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>